<div class="page-controls not-prose" data-page-controls>
  <nav
    id="page-contents"
    class="page-contents"
    aria-label="Page contents"
    hidden
  >
    <div class="page-contents-title">Contents</div>
    <a href="#top">Title</a>
    <a href="#abstract">Abstract</a>
    <a href="#benchmark-overview-title">Benchmark setting</a>
    <a href="#benchmark-overall-title">Benchmark overall</a>
    <div class="page-contents-group">Tables</div>
    <a href="#table-1">Table 1 · VLMs</a>
    <a href="#table-2">Table 2 · Hardware</a>
    <div class="page-contents-group">Figures</div>
    <a href="#figure-1">Figure 1 · Infrastructure</a>
    <a href="#figure-3">Figure 3 · Stage throughput</a>
    <a href="#figure-4">Figure 4 · Temperature</a>
    <a href="#figure-5">Figure 5 · Decode throughput</a>
    <div class="page-contents-group">Findings</div>
    <a href="#finding-1">Finding 1 · Softmax</a>
    <a href="#finding-2">Finding 2 · Pipeline bubbles</a>
    <a href="#finding-3">Finding 3 · Linear attention</a>
    <a href="#finding-4">Finding 4 · Tensor layout</a>
    <a href="#finding-5">Finding 5 · Decode attention</a>
    <a href="#finding-6">Finding 6 · Sweet Resolution</a>
    <a href="#bibtex-citation">BibTeX citation</a>
  </nav>
  <button
    type="button"
    class="contents-toggle"
    aria-controls="page-contents"
    aria-expanded="false"
  >
    <span aria-hidden="true">☰</span>
    Contents
  </button>
</div>

<dialog class="image-lightbox not-prose" aria-labelledby="image-lightbox-title">
  <div class="image-lightbox-bar">
    <strong id="image-lightbox-title"></strong>
    <button type="button" class="image-lightbox-close" aria-label="Close image">
      ×
    </button>
  </div>
  <div class="image-lightbox-scroll">
    <button
      type="button"
      class="image-lightbox-image"
      aria-label="Show image at actual size"
      aria-pressed="false"
    >
      <img alt="" />
    </button>
  </div>
  <p class="lightbox-caption" id="image-lightbox-caption"></p>
</dialog>

<dialog
  class="image-lightbox table-lightbox not-prose"
  aria-labelledby="table-lightbox-title"
>
  <div class="image-lightbox-bar">
    <strong id="table-lightbox-title"></strong>
    <button type="button" class="image-lightbox-close" aria-label="Close table"
      >×</button
    >
  </div>
  <div class="table-lightbox-scroll"></div>
  <p class="lightbox-caption" id="table-lightbox-caption"></p>
</dialog>

<style>
  .page-controls {
    position: fixed;
    z-index: 40;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    font-size: 0.875rem;
  }

  .contents-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-zinc-300);
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-zinc-900);
    box-shadow: 0 4px 18px rgb(0 0 0 / 12%);
    font: inherit;
  }

  .contents-toggle:hover,
  .contents-toggle[aria-expanded="true"] {
    background: var(--color-zinc-100);
  }

  .page-contents {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.75rem);
    display: flex;
    flex-direction: column;
    width: min(20rem, calc(100vw - 2rem));
    max-height: min(70dvh, 35rem);
    overflow-y: auto;
    padding: 0.75rem;
    border: 1px solid var(--color-zinc-200);
    border-radius: 0.75rem;
    background: var(--color-white);
    box-shadow: 0 12px 36px rgb(0 0 0 / 18%);
  }

  .page-contents[hidden] {
    display: none;
  }

  .page-contents-title,
  .page-contents-group {
    padding: 0.4rem 0.6rem;
    color: var(--color-zinc-600);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .page-contents a {
    padding: 0.45rem 0.6rem;
    border-radius: 0.4rem;
    color: var(--color-zinc-900);
    text-decoration: none;
  }

  .page-contents a:hover,
  .page-contents a:focus-visible {
    background: var(--color-zinc-100);
  }

  .contents-toggle:focus-visible,
  .page-contents a:focus-visible,
  .image-lightbox button:focus-visible,
  .table-zoom:focus-visible {
    outline: 2px solid var(--color-blue-700);
    outline-offset: 2px;
  }

  .image-lightbox {
    width: min(96vw, 120rem);
    max-width: none;
    max-height: 94dvh;
    padding: 0;
    border: 1px solid var(--color-zinc-300);
    border-radius: 0.75rem;
    background: var(--color-white);
    color: var(--color-zinc-900);
    box-shadow: 0 20px 60px rgb(0 0 0 / 30%);
  }

  .image-lightbox[open] {
    display: flex;
    flex-direction: column;
  }

  .image-lightbox::backdrop {
    background: rgb(0 0 0 / 70%);
  }

  .image-lightbox-bar {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--color-zinc-200);
  }

  .image-lightbox-close {
    width: 2rem;
    height: 2rem;
    border-radius: 0.3rem;
    font-size: 1.5rem;
    line-height: 1;
  }

  .image-lightbox-close:hover {
    background: var(--color-zinc-100);
  }

  .image-lightbox-scroll {
    min-height: 0;
    overflow: auto;
  }

  .image-lightbox-image {
    display: block;
    width: max-content;
    min-width: 100%;
    margin: auto;
    padding: 1rem;
    cursor: zoom-in;
  }

  .image-lightbox-image img {
    display: block;
    width: auto;
    height: auto;
    max-width: calc(96vw - 2rem);
    max-height: calc(94dvh - 5.5rem);
    margin: auto;
  }

  .image-lightbox-image[aria-pressed="true"] {
    cursor: zoom-out;
  }

  .image-lightbox-image[aria-pressed="true"] img {
    max-width: none;
    max-height: none;
  }

  .lightbox-caption {
    flex: none;
    max-height: 24dvh;
    overflow-y: auto;
    margin: 0;
    padding: 0.75rem 1.25rem 1rem;
    border-top: 1px solid var(--color-zinc-200);
    color: var(--color-zinc-700);
    font-size: 0.875rem;
    line-height: 1.55;
    text-align: center;
  }

  .table-lightbox {
    width: min(96vw, 82rem);
  }

  .table-lightbox-scroll {
    min-height: 0;
    overflow: auto;
    padding: clamp(0.75rem, 2vw, 1.75rem);
  }

  .table-lightbox-scroll :global(table) {
    width: 100%;
    min-width: 46rem;
    border-collapse: collapse;
    color: var(--color-zinc-900);
    font-size: 1rem;
    line-height: 1.45;
    text-align: left;
  }

  .table-lightbox-scroll :global(th),
  .table-lightbox-scroll :global(td) {
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid var(--color-zinc-200);
    vertical-align: top;
  }

  .table-lightbox-scroll :global(th) {
    position: sticky;
    top: 0;
    background: var(--color-zinc-100);
    font-weight: 700;
  }

  .table-lightbox-scroll :global(tbody tr:hover td) {
    background: var(--color-zinc-50);
  }

  .table-lightbox-scroll :global(td:first-child) {
    font-weight: 600;
    white-space: nowrap;
  }
</style>

<script>
  const controls = document.querySelector<HTMLElement>("[data-page-controls]");
  const toggle = controls?.querySelector<HTMLButtonElement>(".contents-toggle");
  const contents = controls?.querySelector<HTMLElement>(".page-contents");
  const dialog = document.querySelector<HTMLDialogElement>(".image-lightbox");
  const lightboxTitle = dialog?.querySelector<HTMLElement>(
    "#image-lightbox-title",
  );
  const lightboxImage = dialog?.querySelector<HTMLImageElement>("img");
  const imageToggle = dialog?.querySelector<HTMLButtonElement>(
    ".image-lightbox-image",
  );
  const imageCaption = dialog?.querySelector<HTMLElement>(
    "#image-lightbox-caption",
  );
  const tableDialog =
    document.querySelector<HTMLDialogElement>(".table-lightbox");
  const tableTitle = tableDialog?.querySelector<HTMLElement>(
    "#table-lightbox-title",
  );
  const tableCaption = tableDialog?.querySelector<HTMLElement>(
    "#table-lightbox-caption",
  );
  const tableScroll = tableDialog?.querySelector<HTMLElement>(
    ".table-lightbox-scroll",
  );
  let activeTrigger: HTMLElement | null = null;

  const setContentsOpen = (open: boolean) => {
    if (!contents || !toggle) return;
    contents.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () =>
    setContentsOpen(contents?.hidden ?? false),
  );
  contents?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) {
      setContentsOpen(false);
    }
  });

  document.addEventListener("click", (event) => {
    if (event.target instanceof Element) {
      const trigger = event.target.closest<HTMLAnchorElement>(
        "a[data-figure-zoom]",
      );
      if (trigger && dialog && lightboxTitle && lightboxImage && imageToggle) {
        event.preventDefault();
        activeTrigger = trigger;
        lightboxTitle.textContent = trigger.dataset.figureLabel ?? "Figure";
        if (imageCaption)
          imageCaption.textContent =
            trigger
              .closest("figure")
              ?.querySelector("figcaption")
              ?.textContent?.trim() ?? "";
        lightboxImage.src = trigger.href;
        lightboxImage.alt = trigger.querySelector("img")?.alt ?? "";
        imageToggle.setAttribute("aria-pressed", "false");
        imageToggle.setAttribute("aria-label", "Show image at actual size");
        dialog.showModal();
      }
      const tableTrigger = event.target.closest<HTMLButtonElement>(
        "button[data-table-zoom]",
      );
      if (
        tableTrigger &&
        tableDialog &&
        tableTitle &&
        tableCaption &&
        tableScroll
      ) {
        const source = document.getElementById(
          tableTrigger.dataset.tableZoom ?? "",
        );
        const table = source?.querySelector("table");
        if (table) {
          activeTrigger = tableTrigger;
          tableTitle.textContent =
            source?.querySelector("figcaption a")?.textContent ?? "Table";
          tableCaption.textContent =
            source
              ?.querySelector("figcaption")
              ?.textContent?.replace("⤢ Enlarge", "")
              .trim() ?? "";
          tableScroll.replaceChildren(table.cloneNode(true));
          tableDialog.showModal();
        }
      }
    }
    if (controls && !controls.contains(event.target as Node))
      setContentsOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setContentsOpen(false);
  });

  dialog
    ?.querySelector(".image-lightbox-close")
    ?.addEventListener("click", () => {
      dialog.close();
    });
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("close", () => {
    activeTrigger?.focus({ preventScroll: true });
    activeTrigger = null;
  });
  tableDialog
    ?.querySelector(".image-lightbox-close")
    ?.addEventListener("click", () => {
      tableDialog.close();
    });
  tableDialog?.addEventListener("click", (event) => {
    if (event.target === tableDialog) tableDialog.close();
  });
  tableDialog?.addEventListener("close", () => {
    activeTrigger?.focus({ preventScroll: true });
    activeTrigger = null;
  });
  imageToggle?.addEventListener("click", () => {
    const zoomed = imageToggle.getAttribute("aria-pressed") !== "true";
    imageToggle.setAttribute("aria-pressed", String(zoomed));
    imageToggle.setAttribute(
      "aria-label",
      zoomed ? "Fit image to window" : "Show image at actual size",
    );
    if (zoomed) {
      const viewport = dialog?.querySelector(".image-lightbox-scroll");
      if (viewport)
        viewport.scrollLeft = (viewport.scrollWidth - viewport.clientWidth) / 2;
    }
  });
</script>
