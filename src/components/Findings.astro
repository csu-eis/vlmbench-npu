---
import { Image } from "astro:assets";
import faLatency from "../assets/findings/fa-bound-a.png";
import faRoofline from "../assets/findings/fa-bound-b.png";
import faInstructions from "../assets/findings/fa-bound-c.png";
import rknpuUnits from "../assets/findings/rknpu-task-granularity-b.png";
import pipelineBubbles from "../assets/findings/fa-hmx-pipe-softmax-bubble.png";
import gdnSpeedup from "../assets/findings/gdn-speedup.png";
import gdnLatency from "../assets/findings/gdn-latency.png";
import hmxDataflow from "../assets/findings/hmx-dataflow.png";
import gdnUtilization from "../assets/findings/gdn-hmx-util.png";
import moduleLatency from "../assets/findings/module-latency-oneplus13t.png";
import attentionShape from "../assets/findings/attn-shape-cpu-npu-ratio.png";
import ttftStaircase from "../assets/findings/ttft-staircase.png";
import resolutionAccuracy from "../assets/findings/resolution-accuracy.png";

// Findings and plot descriptions follow the active Overleaf sections.
// Figure numbers below continue this project's visible numbering after Figure 5.
const findings = [
  {
    number: 1,
    title: "Softmax limits FlashAttention on Hexagon",
    conclusion:
      "Softmax is the execution bottleneck for FlashAttention on Hexagon v79. It reaches 85% of the measured HVX compute roof, limiting the kernel's performance.",
    explanation:
      "The latency breakdown, softmax roofline, and instruction analysis connect the cost to repeated vector work for the exponential operation.",
    figures: [
      {
        number: 6,
        image: faLatency,
        alt: "FlashAttention latency breakdown with softmax as the largest component",
        caption:
          "FlashAttention latency breakdown: softmax dominates the measured kernel time.",
      },
      {
        number: 7,
        image: faRoofline,
        alt: "Softmax throughput relative to the Hexagon HVX compute roof",
        caption: "Softmax throughput approaches the measured HVX compute roof.",
      },
      {
        number: 8,
        image: faInstructions,
        alt: "Instruction breakdown of softmax exponential computation on Hexagon HVX",
        caption:
          "Disassembly of the HVX softmax kernel shows the instruction cost of its software exponential.",
      },
    ],
  },
  {
    number: 2,
    title: "Softmax creates NPU pipeline bubbles",
    conclusion:
      "Hardware lookup-table softmax alone cannot eliminate NPU pipeline bubbles. On RKNPU, DPU softmax dominates attention latency; on Hexagon, HMX waits for HVX softmax results.",
    explanation:
      "The RKNPU unit breakdown and Hexagon execution schedule show how unequal work across compute units leaves matrix hardware idle during single-request inference.",
    figures: [
      {
        number: 9,
        image: rknpuUnits,
        alt: "RK3588 RKNPU attention step latency broken down by CNA, DPU, and memory units",
        caption:
          "Full-attention step time on RK3588 RKNPU by compute unit; DPU softmax accounts for 66.5% versus 16.9% for CNA matmuls.",
      },
      {
        number: 10,
        image: pipelineBubbles,
        alt: "FlashAttention schedule showing HMX waiting for HVX softmax outputs",
        caption:
          "FlashAttention pipeline on Hexagon: HMX finishes its ready matrix work and waits for HVX softmax, creating idle intervals.",
      },
    ],
  },
  {
    number: 3,
    title: "Linear attention and HMX layout overhead",
    conclusion:
      "GDN runs slower than the Adreno GPU on the tested Hexagon NPUs, even where full attention is accelerated. At 1024 tokens, GDN reaches only 0.29–0.70× GPU speedup, versus 2.7–6.4× for full attention.",
    secondConclusion:
      "GDN's HMX kernel is bottlenecked by HVX transposition and repacking before its activation–activation GEMMs. HMX utilization falls to 3.8–3.9% in the measured execution.",
    explanation:
      "Operator speedup and latency measurements show the gap with the GPU. HMX/HVX profiling shows low matrix utilization; the two GEMM data flows explain why GDN's changing activation operand must be transformed for each invocation.",
    figures: [
      {
        number: 11,
        image: gdnSpeedup,
        alt: "GDN and full-attention speedups on Hexagon relative to Adreno GPU",
        caption:
          "Operator speedup relative to Adreno GPU for GDN and full attention on Hexagon.",
      },
      {
        number: 12,
        image: gdnLatency,
        alt: "GDN latency on GPU, HVX, and HMX across input sequence lengths",
        caption:
          "GDN latency across sequence lengths of 64–2048 tokens for the GPU, FP32 HVX recurrence, and FP16 HMX kernel.",
      },
      {
        number: 14,
        image: gdnUtilization,
        alt: "HVX instruction activity and HMX utilization in GDN text prefill",
        caption:
          "GDN HMX/HVX profiling reveals 3.8–3.9% HMX utilization and substantial HVX work.",
      },
      {
        number: 13,
        image: hmxDataflow,
        alt: "Comparison of HMX static-weight GEMM and GDN activation-activation GEMM data flows",
        caption:
          "HMX data flows: the second operand of GDN's activation–activation GEMM requires an HVX transpose before each call.",
      },
    ],
  },
  {
    number: 5,
    title: "Decode performance depends on attention shape",
    conclusion:
      "Neither CPU nor NPU consistently decodes faster. Attention, rather than FFN, accounts for much of the measured gap; the head dimension, group size, and context length determine the matrix parallelism available to the NPU.",
    explanation:
      "Module-level latency separates attention from FFN. Controlled attention-shape sweeps then show when NPU execution overtakes the CPU and when small shapes favor the CPU.",
    figures: [
      {
        number: 15,
        image: moduleLatency,
        alt: "CPU and NPU attention and FFN latency per decode token on OnePlus 13T",
        caption:
          "CPU/NPU attention and FFN latency per decode token on OnePlus 13T.",
      },
      {
        number: 16,
        image: attentionShape,
        alt: "CPU-to-NPU latency ratio across attention head dimension, group size, and context length",
        caption:
          "CPU/NPU latency ratio across attention configurations; ratios above one favor the NPU and ratios below one favor the CPU.",
      },
    ],
  },
  {
    number: 6,
    title: "Sweet Resolution is task-specific",
    conclusion:
      "A Sweet Resolution can improve task accuracy with modest time-to-first-token overhead. Its choice depends on both the task's accuracy curve and the measured latency curve.",
    explanation:
      "The latency plot identifies flat, staircase, and rising costs under different preprocessing strategies. The accuracy plot shows which tested resolutions improve individual tasks within those cost ranges.",
    figures: [
      {
        number: 17,
        image: ttftStaircase,
        alt: "Time to first token against input resolution for six VLMs on device and accelerator stacks",
        caption:
          "Single-image time to first token versus input resolution for six VLMs across six device–accelerator stacks.",
      },
      {
        number: 18,
        image: resolutionAccuracy,
        alt: "Task accuracy against input resolution across ten multimodal benchmarks",
        caption:
          "Task accuracy versus input resolution across ten benchmark categories and six VLMs.",
      },
    ],
  },
];
---

<div class="findings not-prose" aria-label="Research findings">
  {
    findings.map((finding) => (
      <section
        id={`finding-${finding.number}`}
        class="finding-section"
        aria-labelledby={`finding-${finding.number}-title`}
      >
        <div class="finding-inner">
          <h2 id={`finding-${finding.number}-title`}>
            {finding.number === 3
              ? "Findings 3–4"
              : `Finding ${finding.number}`}{" "}
            · {finding.title}
          </h2>
          <div class="finding-highlight">
            <strong>Finding {finding.number}</strong>
            <p>{finding.conclusion}</p>
          </div>
          {finding.number === 3 && (
            <div
              id="finding-4"
              class="finding-highlight finding-highlight-second"
            >
              <strong>Finding 4</strong>
              <p>{finding.secondConclusion}</p>
            </div>
          )}
          <p class="finding-explanation">{finding.explanation}</p>
          <div
            class:list={[
              "finding-figures",
              finding.number <= 3 && "finding-figures-row",
              finding.number === 1 && "finding-figures-three",
              finding.number === 2 && "finding-figures-two",
              finding.number === 3 && "finding-figures-combined",
            ]}
          >
            {finding.figures.map((figure) => (
              <figure id={`figure-${figure.number}`}>
                <a
                  class="finding-figure-zoom"
                  href={figure.image.src}
                  data-figure-zoom
                  data-figure-label={`Figure ${figure.number}`}
                  aria-label={`Enlarge Figure ${figure.number}`}
                  aria-haspopup="dialog"
                >
                  <Image
                    src={figure.image}
                    alt={figure.alt}
                    format="webp"
                    quality={100}
                    widths={[480, 800, figure.image.width].filter(
                      (width, index, widths) =>
                        width <= figure.image.width &&
                        widths.indexOf(width) === index,
                    )}
                    sizes={
                      finding.number <= 3
                        ? "(min-width: 1024px) 650px, (min-width: 848px) 800px, calc(100vw - 48px)"
                        : "(min-width: 848px) 800px, calc(100vw - 48px)"
                    }
                  />
                </a>
                <figcaption>
                  <a href={`#figure-${figure.number}`}>
                    Figure {figure.number}
                  </a>{" "}
                  {figure.caption}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    ))
  }
</div>

<style>
  .findings {
    margin-block: 1rem 3rem;
  }

  .finding-section {
    padding: 3rem 0;
    border-top: 1px solid var(--color-zinc-200);
    scroll-margin-top: 1.5rem;
  }

  .finding-inner {
    max-width: var(--maximum-text-width);
    margin-inline: auto;
  }

  h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.4rem, 2.5vw, 1.875rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .finding-highlight {
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--color-blue-700);
    border-radius: 0.25rem 0.625rem 0.625rem 0.25rem;
    background: var(--color-zinc-100);
    line-height: 1.55;
  }

  .finding-highlight strong {
    color: var(--color-blue-800);
    font-size: 0.875rem;
  }

  .finding-highlight p,
  .finding-explanation {
    margin: 0.45rem 0 0;
  }

  .finding-highlight-second {
    margin-top: 0.75rem;
    scroll-margin-top: 1.5rem;
  }

  .finding-explanation {
    margin-top: 1.25rem;
    color: var(--color-zinc-700);
    line-height: 1.65;
  }

  .finding-figures {
    display: grid;
    gap: 2.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 64rem) {
    .finding-figures-row {
      position: relative;
      left: 50%;
      width: min(80rem, calc(100cqw - 3rem));
      align-items: start;
      gap: 1.5rem;
      transform: translateX(-50%);
    }

    .finding-figures-three {
      grid-template-columns: minmax(0, 709fr) minmax(0, 549fr) minmax(0, 628fr);
    }

    .finding-figures-two {
      /* Figure 9 is 2:1 and Figure 10 is 3.04:1, so these tracks give equal image heights. */
      grid-template-columns: minmax(0, 2fr) minmax(0, 3.04fr);
    }

    .finding-figures-combined {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .finding-figures-combined figure:nth-child(4) {
      grid-column: 1 / -1;
    }
  }

  figure {
    width: 100%;
    min-width: 0;
    margin: 0;
    scroll-margin-top: 1.5rem;
  }

  .finding-figure-zoom,
  img {
    display: block;
    width: 100%;
  }

  img {
    height: auto;
    margin: 0;
  }

  figcaption {
    margin: 0.85rem 0 0;
    color: var(--color-zinc-600);
    font-size: 0.875rem;
    line-height: 1.55;
    text-align: center;
    text-wrap: pretty;
  }

  figcaption a {
    color: var(--color-zinc-800);
    font-weight: 700;
    text-decoration: none;
  }

  figcaption a:hover {
    text-decoration: underline;
  }
</style>
