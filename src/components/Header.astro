---
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  url: string;
  name: string;
  icon?: string;
  /** Optional Tailwind classes to override the default button colors. */
  className?: string;
};

interface Props {
  title: string;
  authors: Author[];
  conference?: string;
  notes?: Note[];
  links?: Link[];
}

const { title, authors, conference, notes, links } = Astro.props;

// Unique institutions in first-appearance order, used to derive the
// superscript number shown next to each author's name (DeepEn-style).
const institutions = [
  ...new Set(
    authors
      .map((author) => author.institution)
      .filter((institution): institution is string => Boolean(institution)),
  ),
];

const hasBackground = Astro.slots.has("background");
---

<header
  class:list={[
    "full-bleed relative mb-12",
    hasBackground && "-mt-16 pt-24 pb-28",
  ]}
>
  {
    hasBackground && (
      <div class="cover absolute inset-0 z-0 overflow-hidden">
        <slot name="background" />
        {/* Darken the cover so the white header text stays legible. */}
        <div class="absolute inset-0 bg-black/40" />
      </div>
    )
  }
  <div
    class:list={[
      "relative z-10 mx-auto flex max-w-[50rem] flex-col items-center px-6 text-center",
      hasBackground
        ? "gap-10 text-white prose-headings:text-white [text-shadow:0_0_8px_rgba(0,0,0,0.6)]"
        : "gap-6",
    ]}
  >
    <h1 class="my-0 text-5xl font-medium">{title}</h1>
    <div class="not-prose flex flex-row flex-wrap justify-center gap-x-1.5 gap-y-2 text-xl leading-relaxed">
      {
        authors.map((author, index) => {
          const institutionIndex = author.institution
            ? institutions.indexOf(author.institution)
            : -1;
          return (
            <span class="whitespace-nowrap">
              {author.url ? (
                <a
                  class:list={[hasBackground ? "text-blue-200 hover:text-blue-100" : "text-blue-600 hover:text-blue-900", "underline decoration-dashed underline-offset-4 hover:decoration-solid"]}
                  href={author.url}
                >
                  {author.name}
                </a>
              ) : (
                author.name
              )}
              {(institutionIndex >= 0 || author.notes) && (
                <sup class="text-base">
                  {institutionIndex >= 0 && institutionIndex + 1}
                  {author.notes?.join(",")}
                </sup>
              )}
              {index < authors.length - 1 && <span>,</span>}
            </span>
          );
        })
      }
    </div>
    <div class="not-prose flex flex-row flex-wrap justify-center gap-x-1.5 gap-y-1 text-lg leading-relaxed">
      {
        institutions.map((institution, index) => (
          <span class="whitespace-nowrap">
            <sup class="text-sm">{index + 1}</sup>
            {institution}
            {index < institutions.length - 1 && <span>,</span>}
          </span>
        ))
      }
    </div>
    {conference && <div>{conference}</div>}
    {
      notes && (
        <div class="text-center text-sm">
          {
            // prettier-ignore
            notes.map((note, index, array) => (
              <span>
                <sup>{note.symbol}</sup>{note.text}{index < array.length - 1 ? "," : ""}
              </span>
            ))
          }
        </div>
      )
    }
    {
      links && (
        <div class="not-prose flex flex-row flex-wrap justify-center gap-2">
          {links.map((link) => (
            <a
              href={link.url}
              class:list={["flex flex-row items-center gap-2 rounded-full px-5 py-2 text-lg hover:no-underline",
                link.className ??
                  (hasBackground ? "bg-white hover:bg-zinc-200 text-zinc-800 text-shadow-none shadow-[0_0_8px_rgba(0,0,0,0.6)]" : "bg-zinc-800 text-white hover:bg-black dark:text-zinc-900 dark:hover:bg-zinc-50 dark:bg-zinc-200")
              ]}
            >
              {link.icon && <Icon name={link.icon} />}
              <span>{link.name}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</header>

<style>
  /* Make the slotted cover (Picture/Video, or a plain <img>/<video>) fill the
     header, overriding those components' figure styling. Scoped to `.cover`.
     Kept as scoped CSS because expressing it with Tailwind would require
     repeating the descendant variant on every declaration. */
  .cover :global(:is(picture, img, video)) {
    position: absolute;
    inset: 0;
    /* Zero the margin that `prose` adds to media elements, which would
       otherwise push the cover down and expose the page background. */
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
  }
</style>
